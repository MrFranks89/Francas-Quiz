# Server only. Export in the server process; never put these in EXPO_PUBLIC_*.
# The application does not load this file automatically.
# GENERATION_PROVIDER: openai | anthropic (absent = openai).
GENERATION_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Tetto di spesa della generazione dall'app, in USD (assenti = 0.50 e 5.00, vedi docs/GENERAZIONE.md).
GENERATION_MAX_USD_PER_COURSE=
GENERATION_BUDGET_USD=
