# Solo server. Copiare in services/api/.env oppure salvare dalla schermata Impostazioni dell'app.
# Il server legge services/api/.env all'avvio (percorso alternativo: FORMAZIONE_ENV_FILE) senza
# sovrascrivere le variabili già impostate nel processo. Mai in variabili EXPO_PUBLIC_*.
# Il file services/api/.env è escluso da Git (.gitignore).
# GENERATION_PROVIDER: openai | anthropic | gemini (assente = openai).
GENERATION_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Facoltativa, interruttore di misura: disabled = ragionamento spento (accettato da Claude Haiku 5.5,
# rifiutato con 400 da altri modelli); vuota = predefinito del modello. Vedi docs/GENERAZIONE.md.
ANTHROPIC_THINKING=
# Gemini: solo piano gratuito, solo materiale pubblico (docs/GENERAZIONE.md).
GEMINI_API_KEY=
GEMINI_MODEL=
# Tetto di spesa della generazione dall'app, in USD (assenti = 0.50 e 5.00, vedi docs/GENERAZIONE.md).
GENERATION_MAX_USD_PER_COURSE=
GENERATION_BUDGET_USD=
