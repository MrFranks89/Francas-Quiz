{
  "type": "json_schema",
  "strict": true,
  "name": "ModuleDraft",
  "schema": {
    "$defs": {
      "QuestionDraft": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "single",
              "truefalse",
              "fillblank",
              "scenario",
              "oddOneOut",
              "correctStatement",
              "multiple",
              "matching"
            ],
            "title": "Kind",
            "type": "string"
          },
          "prompt": {
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "situation": {
            "description": "Solo scenario: la situazione concreta. Stringa vuota negli altri tipi.",
            "title": "Situation",
            "type": "string"
          },
          "sentence": {
            "description": "Solo correctStatement: la frase, che contiene `wrong` una sola volta. Stringa vuota negli altri tipi.",
            "title": "Sentence",
            "type": "string"
          },
          "wrong": {
            "description": "Solo correctStatement: la parte sbagliata di `sentence`; le opzioni la sostituiscono e la giusta corregge la frase. Stringa vuota negli altri tipi.",
            "title": "Wrong",
            "type": "string"
          },
          "options": {
            "description": "Lista vuota in truefalse: «Vero» e «Falso» li aggiunge il server. In oddOneOut la giusta è l'opzione che non appartiene al gruppo.",
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "title": "Options",
            "type": "array"
          },
          "correctIndex": {
            "description": "Indice della giusta, da zero. 0 in truefalse e multiple.",
            "title": "Correctindex",
            "type": "integer"
          },
          "correctIndexes": {
            "description": "Solo multiple: le giuste, almeno 2 e non più di metà delle opzioni. Lista vuota negli altri tipi.",
            "items": {
              "type": "integer"
            },
            "title": "Correctindexes",
            "type": "array"
          },
          "correct": {
            "description": "Solo truefalse: true se l'affermazione di `prompt` è vera. false negli altri tipi.",
            "title": "Correct",
            "type": "boolean"
          },
          "pairTerms": {
            "description": "Solo matching: i termini della colonna sinistra, allineati per indice a `options` (la colonna destra): l'abbinamento giusto è pairTerms[i] con options[i]. Lista vuota negli altri tipi.",
            "items": {
              "type": "string"
            },
            "title": "Pairterms",
            "type": "array"
          },
          "rationales": {
            "items": {
              "type": "string"
            },
            "title": "Rationales",
            "type": "array"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "sourceRefs": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Sourcerefs",
            "type": "array"
          },
          "difficulty": {
            "enum": [
              "base",
              "medio",
              "avanzato"
            ],
            "title": "Difficulty",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "prompt",
          "situation",
          "sentence",
          "wrong",
          "options",
          "correctIndex",
          "correctIndexes",
          "correct",
          "pairTerms",
          "rationales",
          "explanation",
          "sourceRefs",
          "difficulty"
        ],
        "title": "QuestionDraft",
        "type": "object"
      },
      "SlideDraft": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "minLength": 1,
            "title": "Heading",
            "type": "string"
          },
          "body": {
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "highlight": {
            "title": "Highlight",
            "type": "string"
          },
          "sourceRefs": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Sourcerefs",
            "type": "array"
          }
        },
        "required": [
          "heading",
          "body",
          "highlight",
          "sourceRefs"
        ],
        "title": "SlideDraft",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "title": {
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "objectives": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Objectives",
        "type": "array"
      },
      "slides": {
        "items": {
          "$ref": "#/$defs/SlideDraft"
        },
        "minItems": 1,
        "title": "Slides",
        "type": "array"
      },
      "questions": {
        "items": {
          "$ref": "#/$defs/QuestionDraft"
        },
        "minItems": 1,
        "title": "Questions",
        "type": "array"
      }
    },
    "required": [
      "title",
      "objectives",
      "slides",
      "questions"
    ],
    "title": "ModuleDraft",
    "type": "object"
  }
}
