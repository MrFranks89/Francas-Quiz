      "$defs": {
        "CorrectStatementDraft": {
          "type": "object",
          "description": "Correggi l'errore: `sentence` contiene `wrong` una sola volta; le opzioni sostituiscono `wrong` e la giusta corregge la frase.",
          "title": "CorrectStatementDraft",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "correctStatement"
              ],
              "title": "Kind"
            },
            "prompt": {
              "type": "string",
              "title": "Prompt",
              "description": "{minLength: 1}"
            },
            "sentence": {
              "type": "string",
              "title": "Sentence",
              "description": "{minLength: 1}"
            },
            "wrong": {
              "type": "string",
              "title": "Wrong",
              "description": "{minLength: 1}"
            },
            "options": {
              "type": "array",
              "title": "Options",
              "items": {
                "type": "string"
              },
              "description": "{maxItems: 6, minItems: 2}"
            },
            "correctIndex": {
              "type": "integer",
              "title": "Correctindex"
            },
            "rationales": {
              "type": "array",
              "title": "Rationales",
              "items": {
                "type": "string"
              }
            },
            "explanation": {
              "type": "string",
              "title": "Explanation",
              "description": "{minLength: 1}"
            },
            "sourceRefs": {
              "type": "array",
              "title": "Sourcerefs",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "base",
                "medio",
                "avanzato"
              ],
              "title": "Difficulty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "prompt",
            "sentence",
            "wrong",
            "options",
            "correctIndex",
            "rationales",
            "explanation",
            "sourceRefs",
            "difficulty"
          ]
        },
