{
  "format": {
    "type": "json_schema",
    "schema": {
      "$defs": {
        "QuestionDraft": {
          "type": "object",
          "title": "QuestionDraft",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "single",
                "truefalse",
                "fillblank",
                "scenario",
                "oddOneOut",
                "correctStatement",
                "multiple",
                "matching"
              ],
              "title": "Kind"
            },
            "prompt": {
              "type": "string",
              "title": "Prompt",
              "description": "{minLength: 1}"
            },
            "situation": {
              "type": "string",
              "description": "Solo scenario: la situazione concreta. Stringa vuota negli altri tipi.",
              "title": "Situation"
            },
            "sentence": {
              "type": "string",
              "description": "Solo correctStatement: la frase, che contiene `wrong` una sola volta. Stringa vuota negli altri tipi.",
              "title": "Sentence"
            },
            "wrong": {
              "type": "string",
              "description": "Solo correctStatement: la parte sbagliata di `sentence`; le opzioni la sostituiscono e la giusta corregge la frase. Stringa vuota negli altri tipi.",
              "title": "Wrong"
            },
            "options": {
              "type": "array",
              "description": "Lista vuota in truefalse: «Vero» e «Falso» li aggiunge il server. In oddOneOut la giusta è l'opzione che non appartiene al gruppo.\n\n{maxItems: 6}",
              "title": "Options",
              "items": {
                "type": "string"
              }
            },
            "correctIndex": {
              "type": "integer",
              "description": "Indice della giusta, da zero. 0 in truefalse e multiple.",
              "title": "Correctindex"
            },
            "correctIndexes": {
              "type": "array",
              "description": "Solo multiple: le giuste, almeno 2 e non più di metà delle opzioni. Lista vuota negli altri tipi.",
              "title": "Correctindexes",
              "items": {
                "type": "integer"
              }
            },
            "correct": {
              "type": "boolean",
              "description": "Solo truefalse: true se l'affermazione di `prompt` è vera. false negli altri tipi.",
              "title": "Correct"
            },
            "pairTerms": {
              "type": "array",
              "description": "Solo matching: i termini della colonna sinistra, allineati per indice a `options` (la colonna destra): l'abbinamento giusto è pairTerms[i] con options[i]. Lista vuota negli altri tipi.",
              "title": "Pairterms",
              "items": {
                "type": "string"
              }
            },
            "rationales": {
              "type": "array",
              "title": "Rationales",
              "items": {
                "type": "string"
              }
            },
            "explanation": {
              "type": "string",
              "title": "Explanation",
              "description": "{minLength: 1}"
            },
            "sourceRefs": {
              "type": "array",
              "title": "Sourcerefs",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "base",
                "medio",
                "avanzato"
              ],
              "title": "Difficulty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "prompt",
            "situation",
            "sentence",
            "wrong",
            "options",
            "correctIndex",
            "correctIndexes",
            "correct",
            "pairTerms",
            "rationales",
            "explanation",
            "sourceRefs",
            "difficulty"
          ]
        },
        "SlideDraft": {
          "type": "object",
          "title": "SlideDraft",
          "properties": {
            "heading": {
              "type": "string",
              "title": "Heading",
              "description": "{minLength: 1}"
            },
            "body": {
              "type": "string",
              "title": "Body",
              "description": "{minLength: 1}"
            },
            "highlight": {
              "type": "string",
              "title": "Highlight"
            },
            "sourceRefs": {
              "type": "array",
              "title": "Sourcerefs",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "heading",
            "body",
            "highlight",
            "sourceRefs"
          ]
        }
      },
      "type": "object",
      "title": "ModuleDraft",
      "properties": {
        "title": {
          "type": "string",
          "title": "Title",
          "description": "{minLength: 1}"
        },
        "objectives": {
          "type": "array",
          "title": "Objectives",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "slides": {
          "type": "array",
          "title": "Slides",
          "items": {
            "$ref": "#/$defs/SlideDraft"
          },
          "minItems": 1
        },
        "questions": {
          "type": "array",
          "title": "Questions",
          "items": {
            "$ref": "#/$defs/QuestionDraft"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "objectives",
        "slides",
        "questions"
      ]
    }
  },
  "effort": "low"
}
