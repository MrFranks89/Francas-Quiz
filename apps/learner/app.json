{
  "expo": {
    "name": "Studio Formazione",
    "slug": "studio-formazione",
    "version": "0.1.0",
    "scheme": "studioformazione",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#F3F7F8",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7F8",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#132C3E"
          }
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": false,
          "style": "light",
          "enforceContrast": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app richiede l'accesso alle foto per caricare documenti da digitalizzare.",
          "cameraPermission": "L'app richiede l'accesso alla fotocamera per scattare foto ai documenti da digitalizzare."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "it.formazione.studio",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#087E83"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
